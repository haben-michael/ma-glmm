import sympy as sy

m, x, theta = sy.symbols('m x theta')
beta = sy.IndexedBase('beta')

# 1. Define a custom SymPy Function for the Logistic Sigmoid
class LogisticSigmoid(sy.Function):
    # This tells SymPy how to differentiate the function
    def fdiff(self, argindex=1):
        # The derivative of sigmoid(z) wrt z is sigmoid(z) * (1 - sigmoid(z))
        return self * (1 - self)

# 2. Set up the normal PDF and our new custom probability function
pdf_normal = 1 / sy.sqrt(2 * sy.pi) * sy.exp(-theta**2 / 2)
z = beta[2] + sy.sqrt(beta[1]) * theta
pr = LogisticSigmoid(z)

# 3. Build the integral and take the log
integrand = sy.binomial(m, x) * (pr**x) * ((1 - pr)**(m - x)) * pdf_normal
likUnit = sy.Integral(integrand, theta)
lUnit = sy.log(likUnit)

# 4. Take the second derivative
d2_lUnit = lUnit.diff(beta[1], 2)

# 5. Clean up SMARTLY (Without expanding the integral into a million pieces)
# Instead of expanding the integral, let's just ask SymPy to factor the expressions 
# INSIDE the integral to group terms together, just like Mathematica does.
simplified_result = d2_lUnit.replace(
    sy.Integral, 
    lambda expr, var: sy.Integral(sy.factor(expr), var)
)

print(simplified_result)


# 1. Pull out terms independent of theta (like binomial, pi, constants)
def pull_constants(integral_expr, var=theta):
    # .as_independent(var) splits expression into (Constant_Part, Dependent_Part)
    const, dep = integral_expr.function.as_independent(var)
    return const * sy.Integral(dep, var)

# Apply the rule to all integrals in your result
polished_result = simplified_result.replace(sy.Integral, pull_constants)

