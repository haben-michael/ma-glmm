Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"binomial", "-", 
    RowBox[{"normal", " ", "model", " ", "for", " ", "IRR"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"$Path", ",", 
      RowBox[{"NotebookDirectory", "[", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pr", "[", 
      RowBox[{"theta_", ",", "mu_", ",", "tau2_"}], "]"}], ":=", 
     RowBox[{"LogisticSigmoid", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"Tt", "/", "Tc"}], "]"}], "+", "mu", "+", 
       RowBox[{
        RowBox[{"Sqrt", "[", "tau2", "]"}], "*", "theta"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pmf", "[", 
      RowBox[{"x_", ",", "s_", ",", "theta_", ",", "mu_", ",", "tau2_"}], 
      "]"}], ":=", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"BinomialDistribution", "[", 
        RowBox[{"s", ",", 
         RowBox[{"pr", "[", 
          RowBox[{"theta", ",", "mu", ",", "tau2"}], "]"}]}], "]"}], ",", 
       "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orders", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "4"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"orderLong", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"beta", "[", "1", "]"}], ",", 
           RowBox[{"order", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"beta", "[", "2", "]"}], ",", 
           RowBox[{"order", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gDeriv", "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"pmf", "[", 
          RowBox[{"x", ",", "s", ",", "theta", ",", 
           RowBox[{"beta", "[", "2", "]"}], ",", 
           RowBox[{"beta", "[", "1", "]"}]}], "]"}], ",", 
         RowBox[{"Sequence", "@@", "orderLong"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gDeriv", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"gDeriv", ",", 
         RowBox[{"0", "<=", "x", "<=", "s"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gDeriv", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"gDeriv", "/.", 
          RowBox[{"s", "->", 
           RowBox[{"params", "[", "\"\<s\>\"", "]"}]}]}], "/.", 
         RowBox[{"Tt", "->", 
          RowBox[{"params", "[", "\"\<T.t\>\"", "]"}]}]}], "/.", 
        RowBox[{"Tc", "->", 
         RowBox[{"params", "[", "\"\<T.c\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"filename", "=", 
          RowBox[{"StringJoin", "[", 
           RowBox[{"\"\<./mma-formulas/pmf-binomial-irr/pmf-\>\"", ",", 
            RowBox[{"StringJoin", "[", 
             RowBox[{"ToString", "/@", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"order", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"order", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
            "\"\<.txt\>\""}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Put", "[", 
         RowBox[{"gDeriv", ",", "filename"}], "]"}]}], "]"}]}], ",", 
