        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"FactorialPower", "[", 
              RowBox[{"x", ",", "2"}], "]"}], "/", 
             RowBox[{"w", "^", "2"}]}], "-", 
            RowBox[{"Mk", "[", 
             RowBox[{"2", ",", "w"}], "]"}]}], ")"}], "*", 
          RowBox[{"pmf", "[", 
           RowBox[{"x", ",", "params", ",", "w"}], "]"}]}], "-", 
         RowBox[{"2", "*", 
          RowBox[{"Mk", "[", 
           RowBox[{"1", ",", "w"}], "]"}], "*", 
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
