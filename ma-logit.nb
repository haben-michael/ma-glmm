Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"poisson", "-", 
    RowBox[{"normal", " ", "model"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"generate", " ", "pmf", " ", "derivatives"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"$Path", ",", 
      RowBox[{"NotebookDirectory", "[", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"pr", "[", 
       RowBox[{"theta_", ",", "mu_", ",", "tau2_"}], "]"}], ":=", 
      RowBox[{"LogisticSigmoid", "[", 
       RowBox[{"mu", "+", 
        RowBox[{
         RowBox[{"Sqrt", "[", "tau2", "]"}], "*", "theta"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pmf", "[", 
       RowBox[{"x_", ",", "m_", ",", "theta_", ",", "mu_", ",", "tau2_"}], 
       "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"pr", "[", 
         RowBox[{"theta", ",", "mu", ",", "tau2"}], "]"}], "^", "x"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"pr", "[", 
           RowBox[{"theta", ",", "mu", ",", "tau2"}], "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"m", "-", "x"}], ")"}]}]}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lambda", "[", 
      RowBox[{"mu_", ",", "tau2_", ",", "T_", ",", "theta_"}], "]"}], ":=", 
     RowBox[{"T", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"(", 
        RowBox[{"mu", "+", 
         RowBox[{
          RowBox[{"Sqrt", "[", "tau2", "]"}], "*", "theta"}]}], ")"}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pmf", "[", 
      RowBox[{"x_", ",", "T_", ",", "theta_", ",", "mu_", ",", "tau2_"}], 
      "]"}], ":=", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"PoissonDistribution", "[", 
        RowBox[{"lambda", "[", 
         RowBox[{"mu", ",", "tau2", ",", "T", ",", "theta"}], "]"}], "]"}], 
       ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"orders", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"orders", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"orders", ",", "1"}], "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orders", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "4"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"orderLong", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"beta", "[", "1", "]"}], ",", 
           RowBox[{"order", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"beta", "[", "2", "]"}], ",", 
           RowBox[{"order", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gDeriv", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"pmf", "[", 
            RowBox[{"x", ",", "T", ",", "theta", ",", 
             RowBox[{"beta", "[", "2", "]"}], ",", 
             RowBox[{"beta", "[", "1", "]"}]}], "]"}], ",", 
           RowBox[{"Sequence", "@@", "orderLong"}]}], "]"}], ",", 
         RowBox[{"x", ">=", "0"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gDeriv", "=", 
       RowBox[{"gDeriv", "/.", 
        RowBox[{"T", "->", 
         RowBox[{"params", "[", "\"\<T\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gDeriv", "=", 
       RowBox[{"gDeriv", "/.", 
        RowBox[{"Factorial", "->", "factorial"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"filename", "=", 
          RowBox[{"StringJoin", "[", 
           RowBox[{"\"\<./mma-formulas/pmf-poisson/pmf-\>\"", ",", 
            RowBox[{"StringJoin", "[", 
             RowBox[{"ToString", "/@", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"order", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"order", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
            "\"\<.txt\>\""}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Put", "[", 
         RowBox[{"gDeriv", ",", "filename"}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"order", ",", "orders"}], "}"}]}], "]"}]}]}]], "Input",
