   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"M_k", " ", "substitution"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Mk", "[", 
      RowBox[{"k_", ",", "w_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"factMoment", "[", 
       RowBox[{"k", ",", "params", ",", "w"}], "]"}], "/", 
      RowBox[{"w", "^", "k"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pmfRecurrenceRules", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"0", ",", "0", ",", "1"}], "]"}], "[", "pmf", "]"}], "[", 
         RowBox[{"x_", ",", "params_", ",", "w_"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"FactorialPower", "[", 
             RowBox[{"x", ",", "1"}], "]"}], "/", "w"}], "-", 
           RowBox[{"Mk", "[", 
            RowBox[{"1", ",", "w"}], "]"}]}], ")"}], "*", 
         RowBox[{"pmf", "[", 
          RowBox[{"x", ",", "params", ",", "w"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"0", ",", "0", ",", "2"}], "]"}], "[", "pmf", "]"}], "[", 
