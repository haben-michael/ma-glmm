y.max <- seq(1e3, 1.3e4, by = 3e3)
pars <- expand.grid(n.GH = n.GH, y.max = y.max)

format_out <- function(ci_lr, ci_bart, mu, prof_lr, prof_bart) {
  list(
    CIs = list(
      LR = matrix(ci_lr, ncol = 2, byrow = TRUE, dimnames = list(NULL, c("CI.left", "CI.right"))),
      LR.bartlett = matrix(ci_bart, ncol = 2, byrow = TRUE, dimnames = list(NULL, c("CI.left", "CI.right")))
    ),
    mu.grid = mu,
    profile = rbind(LR = prof_lr, LR.bartlett = prof_bart)
  )
}

